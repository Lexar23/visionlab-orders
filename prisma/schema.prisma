
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model tenants {
  id         String    @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  name       String?
  created    DateTime  @default(dbgenerated("LOCALTIMESTAMP")) @db.Timestamp(6)
  updated    DateTime  @default(dbgenerated("LOCALTIMESTAMP")) @db.Timestamp(6)
  deleted    DateTime? @db.Timestamp(6)
  compute_id String?   @db.Uuid
}

model Order {
  id           String    @id @default(uuid())
  orderNumber  String
  patientName  String?
  branch       String
  invoice      String
  startDate    DateTime
  status       String    @default("PENDIENTE")
  observations String?
  deliveredAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Task {
  id            String   @id @default(uuid())
  description   String
  daysToDeliver Int
  owner         String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([createdAt])
}

model Branch {
  id   Int    @id @default(autoincrement())
  name String @unique
}

model Worker {
  id   Int    @id @default(autoincrement())
  name String @unique
}

model TaskOwner {
  id   Int    @id @default(autoincrement())
  name String @unique
}

enum Role {
  ADMIN
  CALIDAD
  PRODUCCION
  GERENCIA
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role     @default(PRODUCCION)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
